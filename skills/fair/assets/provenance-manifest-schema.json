{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OMF Artifact Provenance Manifest",
  "type": "object",
  "required": ["schema_version", "provenance_manifest"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "provenance_manifest": {
      "type": "object",
      "required": ["project", "entities", "agents", "activities", "relations", "dependency_assertions", "reviews", "privacy"],
      "properties": {
        "project": {"type": "object", "required": ["name", "repository", "revision"], "properties": {"name": {"type": "string", "minLength": 1}, "repository": {"$ref": "#/definitions/knownOrUnknown"}, "revision": {"$ref": "#/definitions/knownOrUnknown"}}, "additionalProperties": false},
        "entities": {"type": "array", "items": {"$ref": "#/definitions/entity"}},
        "agents": {"type": "array", "items": {"$ref": "#/definitions/agent"}},
        "activities": {"type": "array", "items": {"$ref": "#/definitions/activity"}},
        "relations": {"type": "array", "items": {"$ref": "#/definitions/relation"}},
        "dependency_assertions": {"type": "array", "items": {"$ref": "#/definitions/dependencyAssertion"}},
        "reviews": {"type": "array", "items": {"$ref": "#/definitions/review"}},
        "privacy": {"type": "object", "required": ["raw_prompt_recorded", "sensitivity", "redaction_reviewed", "notes"], "properties": {"raw_prompt_recorded": {"const": false}, "sensitivity": {"enum": ["public", "internal", "restricted"]}, "redaction_reviewed": {"type": "boolean"}, "notes": {"type": "string"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "knownOrUnknown": {"oneOf": [{"const": "unknown"}, {"type": "string", "minLength": 1, "allOf": [{"not": {"const": "unknown"}}, {"not": {"pattern": "^<.*>$"}}]}]},
    "timestamp": {"type": "string", "format": "date-time"},
    "entity": {
      "type": "object",
      "required": ["id", "logical_id", "type", "path_or_uri", "version", "revision", "content_hash", "status", "contract_authority", "inventory_entry"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "logical_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["artifact", "input", "methodological-source", "template", "software", "dataset", "model", "workflow", "research-object"]},
        "path_or_uri": {"type": "string", "minLength": 1}, "version": {"$ref": "#/definitions/knownOrUnknown"}, "revision": {"$ref": "#/definitions/knownOrUnknown"}, "content_hash": {"$ref": "#/definitions/knownOrUnknown"},
        "status": {"enum": ["draft", "current", "potentially-stale", "invalidated", "superseded", "observed", "consulted", "archived", "unknown"]},
        "contract_authority": {"type": "string", "minLength": 1}, "inventory_entry": {"$ref": "#/definitions/knownOrUnknown"},
        "accessed_at": {"oneOf": [{"$ref": "#/definitions/timestamp"}, {"const": "unknown"}]}, "effective_date": {"oneOf": [{"type": "string", "format": "date"}, {"const": "unknown"}]}, "review_due": {"oneOf": [{"type": "string", "format": "date"}, {"const": "unknown"}]}
      }, "additionalProperties": false
    },
    "agent": {
      "type": "object", "required": ["id", "type", "name", "source", "release", "revision", "content_hash"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["person", "organization", "skill", "runtime", "tool"]}, "name": {"type": "string", "minLength": 1}, "source": {"$ref": "#/definitions/knownOrUnknown"}, "release": {"$ref": "#/definitions/knownOrUnknown"}, "revision": {"$ref": "#/definitions/knownOrUnknown"}, "content_hash": {"$ref": "#/definitions/knownOrUnknown"}}, "additionalProperties": false
    },
    "activity": {
      "type": "object", "required": ["id", "type", "timestamp", "summary", "used", "generated", "associated_agents", "authorization", "parameters", "environment", "decisions", "user_authorized_exception"],
      "properties": {
        "id": {"type": "string", "pattern": "^activity:[A-Za-z0-9._:-]+$"}, "type": {"enum": ["create", "revise", "derive", "transform", "execute", "validate", "review", "migrate", "package", "publish", "archive"]}, "timestamp": {"$ref": "#/definitions/timestamp"}, "summary": {"type": "string", "minLength": 1},
        "used": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "generated": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "associated_agents": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["agent", "role"], "properties": {"agent": {"type": "string"}, "role": {"enum": ["contributor", "executor", "reviewer", "authorizer"]}}, "additionalProperties": false}},
        "authorization": {"type": "object", "required": ["contract_authority", "mode", "scope"], "properties": {"contract_authority": {"type": "string", "minLength": 1}, "mode": {"enum": ["authority-action", "permitted-contribution", "user-exception"]}, "scope": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "parameters": {"type": "object"}, "environment": {"type": "object"},
        "decisions": {"type": "array", "items": {"type": "object", "required": ["summary", "rationale", "evidence", "status"], "properties": {"summary": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "status": {"enum": ["provisional", "accepted", "rejected", "superseded"]}}, "additionalProperties": false}},
        "user_authorized_exception": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "relation": {"type": "object", "required": ["subject", "predicate", "object"], "properties": {"subject": {"type": "string"}, "predicate": {"enum": ["wasGeneratedBy", "used", "wasDerivedFrom", "wasAttributedTo", "wasRevisionOf"]}, "object": {"type": "string"}}, "additionalProperties": false},
    "dependencyAssertion": {"type": "object", "required": ["id", "upstream_entity", "downstream_entity", "status", "caused_by_activity", "asserted_at", "reason", "resolved_by_activity"], "properties": {"id": {"type": "string", "minLength": 1}, "upstream_entity": {"type": "string"}, "downstream_entity": {"type": "string"}, "status": {"enum": ["current", "potentially-stale", "invalidated", "resolved"]}, "caused_by_activity": {"type": "string"}, "asserted_at": {"$ref": "#/definitions/timestamp"}, "reason": {"type": "string", "minLength": 1}, "resolved_by_activity": {"type": ["string", "null"]}}, "additionalProperties": false},
    "review": {"type": "object", "required": ["id", "entity", "status", "reviewer", "reviewed_at", "criteria", "evidence", "activity", "notes"], "properties": {"id": {"type": "string", "minLength": 1}, "entity": {"type": "string"}, "status": {"enum": ["unreviewed", "in-review", "reviewed", "approved", "changes-requested"]}, "reviewer": {"type": "string"}, "reviewed_at": {"oneOf": [{"$ref": "#/definitions/timestamp"}, {"type": "null"}]}, "criteria": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}, "activity": {"type": ["string", "null"]}, "notes": {"type": "string"}}, "additionalProperties": false}
  }
}
