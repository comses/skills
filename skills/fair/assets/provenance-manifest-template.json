{
  "schema_version": "1.0",
  "provenance_manifest": {
    "research_object_name": "<Research Object Name>",
    "version": "<Version>",
    "created_at": "<ISO-8601 Timestamp>",
    "inputs": [
      {
        "name": "<Dataset/Source Name>",
        "inventory_entry": "<Research Object Inventory entry if available>",
        "uri": "<URI/Path>",
        "version": "<Version/Hash>",
        "description": "<Description of input>"
      }
    ],
    "workflow": [
      {
        "step": "<Step Name>",
        "tool": "<Tool/Script Name>",
        "parameters": {
          "<param>": "<value>"
        },
        "output": "<Output File Path>"
      }
    ],
    "environment": {
      "python_version": "<Version>",
      "dependencies": "<Link to requirements.txt or environment.yml>",
      "os": "<OS/Container Image>"
    },
    "related_artifacts": [
      "artifacts/fair/fair-management-plan.md",
      "artifacts/fair/fair-assessment-report.md",
      "artifacts/fair/license-inventory.md"
    ]
  }
}
